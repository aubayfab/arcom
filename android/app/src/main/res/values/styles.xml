<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Btn">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/text</item>
    </style>

    <style name="Btn.Accent">
        <item name="android:background">@drawable/bg_btn_accent</item>
        <item name="android:textColor">@color/accent_ink</item>
        <item name="android:drawableTint">@color/accent_ink</item>
    </style>

    <style name="Btn.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Lien discret, pleine largeur (« Confort », « Autres modules »). -->
    <style name="Btn.Flat">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Bouton de segment : surligné quand sélectionné (store en course, réglage actif). -->
    <style name="Seg" parent="Btn">
        <item name="android:background">@drawable/bg_seg</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Seg.Text">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SegIcon">
        <item name="android:background">@drawable/bg_seg</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/seg_text</item>
    </style>

    <!-- Interrupteur de réglage de connexion (« Connexion auto », « Maintenir la connexion »). -->
    <style name="LinkSwitch">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="RowLabel">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Hint">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
